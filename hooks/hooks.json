{
  "description": "decision-pack: status line of open decisions and the /decision-pack command",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/lib/dp.py\" hook session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/lib/dp.py\" hook stop"
          }
        ]
      }
    ]
  }
}
